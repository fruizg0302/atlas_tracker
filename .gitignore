# Worktrees
.worktrees/

# The directory build artifacts are in.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory where third-party dependencies are downloaded.
/deps/

# Dialyzer's generated lookup tables.
/priv/plts/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like using `mix deps.get --resolve-only`.
# `mix deps` still fetches only what's needed.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
atlas_tracker-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/Webpack
# to bundle your assets, you'll want to ignore these.
/assets/node_modules/
